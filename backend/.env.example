# ==============================================================================
# CropHealthAI Backend Environment Configuration Sample
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="CropHealthAI Backend"
API_V1_STR=/api/v1

# Security & JWT Tokens (Generate with: openssl rand -hex 32)
SECRET_KEY=crophealth-super-secret-key-change-in-production-32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection
# Local development default:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crophealth_db
# Docker compose network default:
DATABASE_URL=postgresql://postgres:postgres@db:5432/crophealth_db

# Redis Caching & Queue URL
REDIS_URL=redis://localhost:6379/0

# Storage & File Upload Settings
MAX_IMAGE_SIZE_MB=10
STORAGE_BASE_URL=/storage

# Cloud Storage / AWS S3 (Optional - leave blank for local filesystem storage)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Twilio SMS Alerts (For outbreak alert broadcasts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Weather Risk API (OpenWeatherMap)
OPENWEATHER_API_KEY=

# Translation Services (Google Cloud Translation)
GOOGLE_TRANSLATE_API_KEY=

# AI Chatbot & Explanations (Google Gemini API)
GEMINI_API_KEY=

# Machine Learning Inference Service
ML_RUN_LOCAL=true
ML_INFERENCE_ENDPOINT=http://localhost:8000/ml/inference
INTERNAL_ML_ENDPOINT=http://127.0.0.1:8000/ml/infer
