# ==============================================================================
# CropHealthAI Frontend Environment Configuration Sample
# Copy this file to .env or .env.local before building or running development server.
# ==============================================================================

# Backend API Endpoint Base URL (Include /api/v1 prefix)
# For local Vite dev server:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# For Docker Nginx reverse proxy setup:
# VITE_API_BASE_URL=/api/v1

# Application Identity
VITE_APP_NAME="CropHealthAI"

# Default Scouting Map Coordinates (e.g. Pune / Maharashtra Agricultural Hub)
VITE_DEFAULT_LAT=18.5204
VITE_DEFAULT_LNG=73.8567

# Localization Defaults (en, hi, mr, te, ta)
VITE_DEFAULT_LANGUAGE=en

# Enable Offline-First IndexedDB Sync
VITE_ENABLE_OFFLINE_SYNC=true

# Observability (Sentry Error Tracking)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

